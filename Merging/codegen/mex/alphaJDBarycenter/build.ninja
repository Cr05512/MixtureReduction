# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /home/cr055/MATLAB
startdir = /home/cr055/MATLAB Workspace/MixtureReduction/Merging

# Toolchain information
cc = /usr/bin/gcc
cxx = g++
linker = /usr/bin/gcc
linkerxx = g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -fwrapv -DNDEBUG -std=c99 -I "$root" -I "$matlabdir Workspace/MixtureReduction/Merging" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=alphaJDBarycenter_mex -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -std=c++11 -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -fwrapv -DNDEBUG -std=c++11 -I "$root" -I "$matlabdir Workspace/MixtureReduction/Merging" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=alphaJDBarycenter_mex -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -o alphaJDBarycenter_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwlapack -lmwblas -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,alphaJDBarycenter_mex.map

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $ldflags

rule linkxx
    command = $linkerxx $in $ldflags

# Build
build $builddir/alphaJDBarycenter_data.o : cc $root/alphaJDBarycenter_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/alphaJDBarycenter_initialize.o : cc $root/alphaJDBarycenter_initialize.c
build $builddir/alphaJDBarycenter_terminate.o : cc $root/alphaJDBarycenter_terminate.c
build $builddir/alphaJDBarycenter.o : cc $root/alphaJDBarycenter.c
build $builddir/RKLDBarycenter.o : cc $root/RKLDBarycenter.c
build $builddir/paramsFromMixture.o : cc $root/paramsFromMixture.c
build $builddir/sum.o : cc $root/sum.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/eye.o : cc $root/eye.c
build $builddir/mrdivide_helper.o : cc $root/mrdivide_helper.c
build $builddir/repmat.o : cc $root/repmat.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/qrsolve.o : cc $root/qrsolve.c
build $builddir/eml_mtimes_helper.o : cc $root/eml_mtimes_helper.c
build $builddir/mtimes.o : cc $root/mtimes.c
build $builddir/FKLDBarycenter.o : cc $root/FKLDBarycenter.c
build $builddir/SKLDBarycenter.o : cc $root/SKLDBarycenter.c
build $builddir/sqrtm.o : cc $root/sqrtm.c
build $builddir/schur.o : cc $root/schur.c
build $builddir/rsf2csf.o : cc $root/rsf2csf.c
build $builddir/trace.o : cc $root/trace.c
build $builddir/det.o : cc $root/det.c
build $builddir/_coder_alphaJDBarycenter_api.o : cc $root/interface/_coder_alphaJDBarycenter_api.c
build $builddir/_coder_alphaJDBarycenter_mex.o : cc $root/interface/_coder_alphaJDBarycenter_mex.c
build $builddir/sqrt.o : cc $root/sqrt.c
build $builddir/chol.o : cc $root/chol.c
build $builddir/alphaJDBarycenter_emxutil.o : cc $root/alphaJDBarycenter_emxutil.c
build $builddir/alphaJDBarycenter_mexutil.o : cc $root/alphaJDBarycenter_mexutil.c
build $builddir/_coder_alphaJDBarycenter_info.o : cc $root/interface/_coder_alphaJDBarycenter_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/alphaJDBarycenter_mex.mexa64 : link $builddir/alphaJDBarycenter_data.o $builddir/rt_nonfinite.o $builddir/alphaJDBarycenter_initialize.o $builddir/alphaJDBarycenter_terminate.o $builddir/alphaJDBarycenter.o $builddir/RKLDBarycenter.o $builddir/paramsFromMixture.o $builddir/sum.o $builddir/sumMatrixIncludeNaN.o $builddir/eml_int_forloop_overflow_check.o $builddir/eye.o $builddir/mrdivide_helper.o $builddir/repmat.o $builddir/warning.o $builddir/qrsolve.o $builddir/eml_mtimes_helper.o $builddir/mtimes.o $builddir/FKLDBarycenter.o $builddir/SKLDBarycenter.o $builddir/sqrtm.o $builddir/schur.o $builddir/rsf2csf.o $builddir/trace.o $builddir/det.o $builddir/_coder_alphaJDBarycenter_api.o $builddir/_coder_alphaJDBarycenter_mex.o $builddir/sqrt.o $builddir/chol.o $builddir/alphaJDBarycenter_emxutil.o $builddir/alphaJDBarycenter_mexutil.o $builddir/_coder_alphaJDBarycenter_info.o $builddir/c_mexapi_version.o 
